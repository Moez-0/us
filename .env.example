# ==========================================
# "Us." Private Couple App Configuration
# ==========================================
# 1. Create a Supabase project at https://supabase.com
# 2. Run /supabase/setup.sql in Supabase Dashboard > SQL Editor
# 3. The SQL creates the 'memories' Storage bucket and its policies
# 4. In Supabase Project Settings -> API, copy Project URL & anon public key
# 5. Enable Anonymous sign-ins in Authentication -> Providers -> Anonymous
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
